# --- Servidor ---
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- MySQL / RDS ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=practilink
DB_USER=root
DB_PASSWORD=KPJ16..)

# --- JWT ---
JWT_SECRET=cambia_este_valor_por_uno_seguro
JWT_EXPIRES_IN=8h

# --- AWS ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=practilink-archivos
SES_FROM_EMAIL=no-reply@practilink.com

# --- Correo por Gmail (alternativa a AWS SES para desarrollo/pruebas) ---
# Si se llenan estas dos variables, el sistema manda los correos reales por
# Gmail en vez de simularlos en consola. GMAIL_USER es la cuenta que envía
# (y puede ser la misma que recibe, si es la cuenta de administrador).
#
# Cómo generar GMAIL_APP_PASSWORD (NO es tu contraseña normal de Gmail):
#   1. Activa la verificación en 2 pasos en esa cuenta de Google, si no la
#      tienes ya: https://myaccount.google.com/security
#   2. Ve a https://myaccount.google.com/apppasswords
#   3. Crea una nueva "Contraseña de aplicación" (ponle de nombre "PractiLink")
#   4. Google te da un código de 16 letras — pégalo abajo, sin espacios.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- IA (cuando se conecte Bedrock real) ---
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
